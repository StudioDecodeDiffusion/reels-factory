      "energie": 1,
      "sfx": [
        "pop"
      ],
      "dialogue": [
        {
          "qui": "narrateur",
          "texte": "Déco, ma mamie m'écrit : est-ce que sa retraite va baisser en 2027 ?",
          "expression": "triste"
        },
        {
          "qui": "mascotte",
          "texte": "Rassure-la : aucune pension ne baisse. Mais elles n'augmenteront pas toutes pareil.",
          "expression": "content"
        }
      ]
    },
    {
      "type": "bigstat",
      "duration": 6.5,
      "value": "3 vitesses",
      "label": "pour la hausse des pensions en janvier 2027",
      "source": "projet de budget de la Sécu 2027",
      "energie": 2,
      "sfx": [
        "ding"
      ],
      "dialogue": [
        {
          "qui": "mascotte",
          "texte": "Le budget de la Sécu prévoit trois vitesses, selon le total de la pension.",
          "expression": "pense"
        }
      ]
    },
    {
      "type": "quiz",
      "duration": 11.2,
      "question": "Mamie touche 1 500 € par mois. Sa pension…",
      "options": [
        "suit toute l'inflation",
        "augmente moins que les prix",
        "est gelée"
      ],
      "bonne": 1,
      "revelation": 4,
      "energie": 3,
      "sfx": [
        "whoosh"
      ],
      "dialogue": [
        {
          "qui": "narrateur",
          "texte": "Elle touche mille cinq cents euros. Alors ?",
          "expression": "pense"
        },
        {
          "qui": "mascotte",
          "texte": "Entre mille deux cent soixante et environ deux mille euros, la hausse sera plus faible que l'inflation.",
          "expression": "clin"
        }
      ]
    },
    {
      "type": "checklist",
      "duration": 10.1,
      "title": "Vrai ou faux ?",
      "items": [
        {
          "texte": "Sous 1 260 € : hausse complète",
          "etat": "vrai"
        },
        {
          "texte": "Au-delà de 2 000 € : la pension baisse",
          "etat": "faux"
        },
        {
          "texte": "On compte toutes les pensions ensemble",
          "etat": "vrai"
        }
      ],
      "energie": 2,
      "sfx": [
        "whoosh",
        "pop"
      ],
      "dialogue": [
        {
          "qui": "mascotte",
          "texte": "Sous mille deux cent soixante euros, hausse complète. Au-delà d'environ deux mille, gel possible, mais aucune baisse. Et on additionne toutes les pensions.",
          "expression": "content"
        }
      ]
    },
    {
      "type": "counter",
      "duration": 10.0,
      "from": 4439.0,
      "to": 3000.0,
      "decimals": 0,
      "suffix": " €",
