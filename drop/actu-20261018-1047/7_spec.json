      "energie": 2,
      "sfx": [
        "whoosh"
      ],
      "dialogue": [
        {
          "qui": "narrateur",
          "texte": "Et pour ses impôts ?",
          "expression": "pense"
        },
        {
          "qui": "mascotte",
          "texte": "Le gouvernement veut baisser ce plafond à trois mille euros. Mais jeudi, l'Assemblée a rejeté cette baisse.",
          "expression": "choc"
        }
